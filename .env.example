APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 本番: MAIL_MAILER=resend (RESEND_API_KEY 必須)
# ローカル dev: smtp + Mailpit (compose.yaml の mailpit サービスで受信、UI: http://localhost:8025)
# もしくは MAIL_MAILER=log で storage/logs/laravel.log に書き出しのみ
# MAIL_HOST=mailpit は Sail コンテナ内から docker network 経由でアクセス。
# ホストから artisan tinker で叩く場合は MAIL_HOST=127.0.0.1 に変えると届く。
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="Sample Stay"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2（ゲスト身分証画像の保存に使用、非公開バケット）
# Cloudflare dashboard > R2 > Manage API tokens で作成
# R2_ENDPOINT は https://<accountId>.r2.cloudflarestorage.com
# R2_URL は Public bucket の公開URL（署名URL運用なら空でよい）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# 公開HP 画像用の R2 公開バケット（同 R2 アカウント、別バケット、Public access ON）
# R2_PUBLIC_URL は R2.dev URL or カスタムドメイン（例: https://static.example.com）
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# ゲスト身分証画像の保存先ディスク（filesystems.php のキー）
# 本番: r2、ローカル: local
GUEST_ID_IMAGE_DISK=r2

# 公開HPが使うドメイン。**設定必須**。空だと公開ルート自体を登録しない
# （Filament panel が '/' で動いている都合上、root 衝突を避けるセーフガード）。
# 本番: example.com、ローカル開発: localhost や example.test など
PUBLIC_HP_DOMAIN=

# 公開HP 画像の配信元。local | r2
# ローカル dev: local (public/images/ に手動配置、git 管理外)
# 本番: r2 (Task #19 完了後、R2 public bucket にアップロード済み前提)
PUBLIC_HP_IMAGE_SOURCE=local

# Resend (メール送信)。https://resend.com/api-keys で発行
# ローカル dev: MAIL_MAILER=log で送信内容を storage/logs/laravel.log に出す運用も可
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# beds24 API v2（詳細は docs/beds24-notes.md）
# Invite Code → Refresh Token 交換で取得。30日未使用で失効。
BEDS24_REFRESH_TOKEN=
# API base（通常デフォルトのままで良い）
# BEDS24_API_BASE=https://beds24.com/api/v2
# Booking Webhook 認証: beds24 dashboard の Custom Header で X-Webhook-Secret: <この値> を設定
BEDS24_WEBHOOK_SECRET=

# Filament admin 初期ユーザー（AdminUserSeeder が使用）
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Anthropic Claude API（Phase 1b AI 下書き生成用）
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 変更したい場合のみ設定（デフォルトは claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6

# HTTP Basic 認証（/reserve/direct など内部テストルート保護用）
# 両方セットしないと middleware は素通し (fail open)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Stripe（直接予約の決済、docs/external-setup.md §5）
# Dashboard → 開発者 → API キー から Secret key を取得（sk_test_... / sk_live_...）
STRIPE_SECRET_KEY=
# Dashboard → 開発者 → Webhook エンドポイント → 署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 適格請求書発行事業者番号（T-XXXXXXXXXXXXX）。領収書・webhook 後の確認メールに記載
STRIPE_INVOICE_NUMBER=
